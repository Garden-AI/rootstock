#!/usr/bin/env bash
# === Sophia (ALCF) — IPC-overhead benchmark ===============================
#PBS -N rootstock-bench
#PBS -A Garden-AI
#PBS -q by-gpu
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:00:00
#PBS -l filesystems=home:eagle
#PBS -j oe
# ==========================================================================
#
# On-demand GPU job that measures Rootstock's i-PI IPC overhead by comparing
# RootstockCalculator against the in-environment direct calculator, for a few
# checkpoints. See `rootstock benchmark --help` for the methodology and options.
#
# Uses the installed `rootstock` CLI (no repo checkout needed). PBS does not
# carry your submit-shell environment into the job, so we put the uv-tool-
# installed CLI on PATH ourselves. Submit from the directory containing this
# script:
#   qsub scripts/benchmark_ipc_overhead_sophia.pbs
#
# Override knobs (qsub -v passes them through):
#   qsub -v CHECKPOINTS="mace-mp-0-medium uma-s-1p1",DEVICES="cuda cpu" \
#     scripts/benchmark_ipc_overhead_sophia.pbs

set -euo pipefail

export ROOTSTOCK_ROOT="${ROOTSTOCK_ROOT:-/eagle/Garden-Ai/rootstock}"

# Checkpoints to compare — a spread of sizes/families. List what's installed:
#   rootstock benchmark --root $ROOTSTOCK_ROOT --list
CHECKPOINTS="${CHECKPOINTS:-mace-mp-0-medium uma-s-1p1 7net-0}"
DEVICES="${DEVICES:-cuda}"
SYSTEM="${SYSTEM:-Cu:256}"
CALLS="${CALLS:-100}"
WARMUP="${WARMUP:-10}"

cd "${PBS_O_WORKDIR:-$(pwd)}"
umask 0002

# Bare PBS jobs start with a minimal PATH; add the uv-tool bin dir.
export PATH="$HOME/.local/bin:$PATH"

# ALCF compute nodes have no direct outbound network; set the proxy defensively
# in case any checkpoint's setup() re-checks gating. The benchmark replays a
# fixed trajectory and never downloads.
export HTTP_PROXY="${HTTP_PROXY:-http://proxy.alcf.anl.gov:3128}"
export HTTPS_PROXY="${HTTPS_PROXY:-http://proxy.alcf.anl.gov:3128}"
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"

if [[ -f ~/.cache/huggingface/token ]]; then
  export HF_TOKEN="$(cat ~/.cache/huggingface/token)"
  export HUGGING_FACE_HUB_TOKEN="$HF_TOKEN"
fi

nvidia-smi | head -4 || true
echo "=== IPC-overhead benchmark (root=$ROOTSTOCK_ROOT) ==="

OUT="rootstock-bench-${PBS_JOBID:-manual}.json"

rootstock benchmark \
  --root "$ROOTSTOCK_ROOT" \
  --checkpoints $CHECKPOINTS \
  --devices $DEVICES \
  --system "$SYSTEM" \
  --calls "$CALLS" \
  --warmup "$WARMUP" \
  --out "$OUT"

echo "=== wrote $OUT ==="
