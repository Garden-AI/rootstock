# Handshake test — verify LAMMPS <-> rootstock worker connection
#
# Start the worker first:
#   rootstock serve mace --root $ROOTSTOCK_ROOT \
#       --socket /tmp/rootstock_test.sock --model medium --device cuda
#
# Then run:
#   lmp -in test_rootstock.lammps

units           metal
atom_style      atomic
boundary        p p p

# Simple 4-atom Cu FCC unit cell
lattice         fcc 3.615
region          box block 0 1 0 1 0 1
create_box      1 box
create_atoms    1 box
mass            1 63.546

fix             mlip all rootstock /tmp/rootstock_test.sock elements Cu

thermo_style    custom step pe f_mlip
thermo          1

# run 0 = just do the handshake and one force evaluation
run             0

print "HANDSHAKE TEST PASSED"
